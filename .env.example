# --- Database: local PG dev, Render PG prod ---
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/patchsignal

# --- Gemma 4 via Gemini API (server only, never NEXT_PUBLIC) ---
GEMINI_API_KEY=
GEMMA_PRIMARY=gemma-4-31b-it
GEMMA_FALLBACK=gemma-4-26b-a4b-it

# --- GitHub read-only ---
GITHUB_TOKEN=
# Hosted demo stays allowlisted; use * for local testing with any public repo
ALLOWLIST_REPOS=patchsignal/demo-signup

# --- Runner ---
RUNNER_TOKEN=
RUNNER_URL=http://localhost:5001
CONTROL_SHA=

# --- Cloudinary (server only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=patchsignal

# --- Auth (HS256 JWT, 7d expiry; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
JWT_SECRET=

# --- Model provider: gemini (default, prize path) or groq (presentation reliability) ---
MODEL_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=

# --- CORS: browser origins allowed to call /api (comma-separated, or * for dev) ---
CORS_ORIGINS=*
